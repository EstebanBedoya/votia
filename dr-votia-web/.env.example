# Base URL of the FastAPI backend. Used ONLY server-side by the BFF route handlers
# (src/app/api/**), never exposed to the browser. Start the backend with:
#   cd ../dr-votia && uv run dr-votia serve
API_BASE_URL=http://127.0.0.1:8000

# Public Supabase project URL. Exposed to the browser (NEXT_PUBLIC_), used to
# build static art asset URLs (see src/lib/assets.ts). NEXT_PUBLIC_ vars are
# inlined at BUILD time, so this must be set when running `pnpm build`.
NEXT_PUBLIC_SUPABASE_URL=https://vaskxyxgehgwrvbjynuy.supabase.co
