# ── Supabase ──────────────────────────────────────────────────────────────────
# Use the service_role key (RLS is enabled; anon key cannot insert).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...

# ── Voyage AI ─────────────────────────────────────────────────────────────────
# https://dash.voyageai.com
VOYAGE_API_KEY=pa-...
# Free tier limits — raise once a payment method is added:
# VOYAGE_MODEL=voyage-3.5
# VOYAGE_TOKENS_PER_MIN=10000
# VOYAGE_REQUESTS_PER_MIN=3

# ── OpenRouter ────────────────────────────────────────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Model overrides (defaults shown):
# OPENROUTER_ANSWER_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_SCORE_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_QUERY_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_ANSWER_MAX_TOKENS=1536

# ── Rate limiting ─────────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_IP=30
# RATE_LIMIT_PER_SESSION=20
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_BYPASS_TOKEN=     # send as X-Admin-Token to skip rate limits

# ── Access gate ───────────────────────────────────────────────────────────────
# Shared code your friends enter to access the app. Required in production.
ACCESS_CODE=elegí-una-frase-secreta
