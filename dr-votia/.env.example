# Supabase — use the service_role key (RLS is enabled; anon cannot insert).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Voyage AI — https://dash.voyageai.com
VOYAGE_API_KEY=

# OpenRouter — for the answering step (RAG generation). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# VOYAGE_MODEL=voyage-3.5
# EMBEDDING_DIM=1024
# OPENROUTER_ANSWER_MODEL=google/gemini-2.5-flash       # chat response (good value)
# OPENROUTER_SCORE_MODEL=anthropic/claude-sonnet-4.6    # radar scoring (quality JSON)
# OPENROUTER_QUERY_MODEL=deepseek/deepseek-v4-flash     # RAG preprocessing (cheap)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_ANSWER_MAX_TOKENS=1536                     # chat answer length budget
# OPENROUTER_SCORE_MAX_TOKENS=2048                      # scoring JSON budget

# Sessions & rate limiting (defaults shown)
# RATE_LIMIT_ENABLED=true               # set false to disable limiting entirely
# RATE_LIMIT_PER_IP=30                   # user turns per window, per IP
# RATE_LIMIT_PER_SESSION=20             # user turns per window, per session
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_BYPASS_TOKEN=              # if set, send X-Admin-Token to skip limiting
# SESSION_HISTORY_LIMIT=10              # prior turns fed to the query refiner
# SESSION_COOKIE_NAME=votia_session
